pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }


    stages {
        stage('Code Checkout') {
            steps {
                checkout scm

                sh '''
                    echo "Repository name:"
                    basename -s .git "$(git config --get remote.origin.url)"

                    echo "Remote URL:"
                    git config --get remote.origin.url

                    echo "Current Git reference:"
                    git name-rev --name-only HEAD

                    echo "Workspace files:"
                    ls -la
                '''
            }
        }

        stage('Build') {
    agent {
        docker {
            image 'python:3.9-slim'
            args '-u root'
        }
    }

    steps {
        sh 'pip install django==3.2'
        sh 'python manage.py check'
        echo 'Django check passed.'
    }
}

        stage('Deploy') {
            when {
                expression {
                    sh(
                        script: "git branch -r --contains HEAD | grep -q 'origin/develop'",
                        returnStatus: true
                    ) == 0
                }
            }

            steps {
                sh '''
                    docker build -t todo .

                    docker rm -f todo_container1 todo_container2 2>/dev/null || true

                    docker run -d --name todo_container1 -p 8000:8000 todo
                    docker run -d --name todo_container2 -p 8001:8000 todo

                    echo "Running Todo containers:"
                    docker ps --filter name=todo_container1 --filter name=todo_container2
                '''
            }

            post {
                always {
                    sh 'docker rm -f todo_container1 todo_container2 2>/dev/null || true'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline executed successfully'
        }

        failure {
            echo 'Pipeline execution failed'
        }

        always {
            echo 'Pipeline execution completed'
        }
    }
}
